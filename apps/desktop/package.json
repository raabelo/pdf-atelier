{
  "name": "@pdf-atelier/desktop",
  "productName": "PDF Atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "dist": "pnpm --filter @pdf-atelier/web build && node scripts/build.mjs && electron-builder --win",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@pdf-atelier/platform": "workspace:*",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "dev.pdfatelier.app",
    "productName": "PDF Atelier",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Atelier",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "PDF-Atelier-Setup-${version}.${ext}",
      "license": "../../LICENSE"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "asar": true,
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ],
    "electronVersion": "44.5.1",
    "electronDist": "../../node_modules/electron/dist"
  },
  "description": "PDF reader and editor",
  "author": "PDF Atelier",
  "license": "AGPL-3.0-only"
}
